# ===== 后端配置（复制为 backend/.env 后按需修改）=====

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- 存储 ----
DATABASE_PATH=data/app.db
EXPORT_DIR=exports

# ---- LLM ----
# mock  = 内置确定性规则，无需 Key 即可全链路演示（默认）
# openai= OpenAI 兼容 API（GLM / DeepSeek / Qwen / ollama 等）
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- 检索 / 解析 ----
RETRIEVAL_DEFAULT_TOP_K=5
RELATION_MODE=rules
IRRELEVANT_SCORE_THRESHOLD=0.05

# ---- 数据划分（官方 6 段名单待课程确认，SRS 3.1，此处仅为占位）----
DATASET_VERSION=locomo10-202610
DEV_CONVERSATIONS=conv-26,conv-30,conv-41,conv-42
TEST_CONVERSATIONS=conv-43,conv-44
